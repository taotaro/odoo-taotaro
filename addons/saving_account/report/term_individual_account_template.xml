<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <template id="term_individual_account_template">
    <t t-call="web.html_container">
      <t t-call="web.external_layout">
        <div class="page">
        <div class="text-end">
          
            <table style="width:100%; border:none; border-collapse:collapse;">
                <tr>
                    <!-- 左邊 -->
                    <td style="width:50%; text-align:right; padding-right:5px; border:none;">
                        Yue Hwa Chinese Products Saving System
                    </td>
            
                    <!-- 右邊 -->
                    <td style="width:50%; text-align:left; padding-left:5px; border:none;">
                        <t t-esc="form['date_from']"/>
                         to 
                        <t t-esc="form['date_to']"/>
                    </td>
                </tr>
            
                <tr>
                    <!-- account no -->
                    <td style="text-align:right; padding-right:5px;border:none;">
                        <t t-esc="account_no"/>
                    </td>
            
                    <!-- account name -->
                    <td style="text-align:left; padding-left:5px; border:none;">
                        <t t-esc="form['account_id'][1]"/>
                    </td>
                </tr>
            </table>

          <h5><center>Term Individual Account Summary</center></h5>
          <table class="table table-bordered" style="table-layout:fixed; text-align:right">
            <tr>
                <th style="text-align:right;">Date</th>
                <th style="text-align:right;">Withdrawals</th>
                <th style="text-align:right;">Deposits</th>
                <th style="text-align:right;">Interest</th>
                <th style="text-align:right;">Balance</th>
                <th style="text-align:right;">Description</th>
                <th style="text-align:right; padding-right:5px;">Ref</th>
            </tr>
            <t t-foreach="entry" t-as="line">
              <tr>
                <td><t t-esc="line['create_date']" t-options="{'widget': 'date', 'format': 'dd MMMM y'}"/></td>
                  <t t-if="line.get('entry_type')=='withdraw'">
                    <td><t t-esc="'{:,.2f}'.format(float(line['amount']))"/></td>
                  </t>
                  <t t-else="">
                    <td></td>
                  </t>
                  <t t-if="line.get('entry_type')=='deposit'">
                    <td><t t-esc="'{:,.2f}'.format(float(line['amount']))"/></td>
                  </t>
                  <t t-else="">
                    <td></td>
                  </t>
                  <t t-if="line.get('entry_type')=='credit_interest'">
                    <td><t t-esc="'{:,.2f}'.format(float(line['amount']))"/></td>
                  </t>
                  <t t-else="">
                    <td></td>
                  </t>
                <td><t t-esc="'{:,.2f}'.format(float(line['balance']))"/></td>
                <td><t t-esc="line.get('description', '')"/></td>
                <!-- <td><t t-esc="line['ref_no']"/></td> -->
                <td style="padding-right:5px;">
                    <t t-esc="line['ref_no']"/>
                </td>
              </tr>
            </t>
            <tr>
              <td>Total</td>
              <td><t t-esc="'{:,.2f}'.format(float(total_withdraw))"/></td>
              <td><t t-esc="'{:,.2f}'.format(float(total_deposit))"/></td>
              <td><t t-esc="'{:,.2f}'.format(float(total_interest))"/></td>
            </tr>
          </table>
        </div>
        </div>
      </t>
    </t>
  </template>

</odoo>